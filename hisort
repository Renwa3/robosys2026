hisort() {
  local prefix="$*"
  local n=200
  local input

  if [ ! -t 0 ]; then
    input="$(cat)"
  else
    input="$(history "$((n + 1))" | sed '$d')"
  fi

  if [ -z "$prefix" ]; then
    printf '%s\n' "$input" \
      | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//' \
      | sed -E '/^[[:space:]]*$/d' \
      | sort \
      | uniq -c \
      | sort -nr \
      | head -n 15
  else
    printf '%s\n' "$input" \
      | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//' \
      | awk -v p="$prefix" 'index($0, p) == 1' \
      | sed -E '/^[[:space:]]*$/d' \
      | sort \
      | uniq -c \
      | sort -nr \
      | head -n 15
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  hisort "$@"
fi
