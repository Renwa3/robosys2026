hisort(){
  local prefix="$*"
  local n=200
  if [ -z "$prefix" ]; then
   history "$((n + 1))" \
    | sed '$d' \
    | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//' \
    | sort \
    | uniq -c \
    | sort -nr \
    | head -n 10
  else
   history "$((n + 1))" \
    | sed '$d' \
    | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//' \
    | awk -v p="$prefix" 'index($0, p) == 1' \
    | sort \
    | uniq -c \
    | sort -nr \
    | head -n 10
  fi
}
