  local n="${1:-50}"
  if ! [[ "$n" =~ ^[0-9]+$ ]] || [ "$n" -le 0 ]; then
    echo "Error: count must be a positive integer" >&2
    return 1
  fi

  history "$((n + 1))" \
    | sed '$d' \
    | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//' \
    | sort \
    | uniq -c \
    | sort -nr
}
